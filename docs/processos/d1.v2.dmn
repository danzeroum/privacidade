<?xml version="1.0" encoding="UTF-8"?>
<!--
  D1@2 — Qual a complexidade do parecer e de quem é a alçada de aprovação?

  Especificação de referência. O runtime que a executa é app/src/mock/decisoes.ts,
  e o teste de conformidade varre todas as combinações de entrada exigindo a
  mesma saída. Divergência é build vermelho.

  Vigência declarada: a partir de 2026-07-01.
  Transferência internacional deixa de ser fator moderado: sem país adequado o titular perde foro e remédio (Art. 33). Combinada com decisão automatizada, passa a exigir o comitê.

  O que este arquivo NÃO diz: entrada ausente cai no cenário mais restritivo.
  Isso é contrato de aplicar(), em volta da tabela, e não linha da tabela — a
  tabela recebe entradas já preenchidas.
-->
<definitions
    xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
    xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
    id="definicoes-d1-v2"
    name="D1 versao 2"
    namespace="https://lastro.exemplo/decisoes">
  <decision id="d1" name="Qual a complexidade do parecer e de quem é a alçada de aprovação?">
    <decisionTable id="tabela-d1-v2" hitPolicy="FIRST">
      <input id="entrada-categoria" label="categoria">
        <inputExpression id="expr-categoria" typeRef="string"><text>categoria</text></inputExpression>
      </input>
      <input id="entrada-volumeTitulares" label="volumeTitulares">
        <inputExpression id="expr-volumeTitulares" typeRef="number"><text>volumeTitulares</text></inputExpression>
      </input>
      <input id="entrada-decisaoAutomatizada" label="decisaoAutomatizada">
        <inputExpression id="expr-decisaoAutomatizada" typeRef="boolean"><text>decisaoAutomatizada</text></inputExpression>
      </input>
      <input id="entrada-transferenciaInternacional" label="transferenciaInternacional">
        <inputExpression id="expr-transferenciaInternacional" typeRef="boolean"><text>transferenciaInternacional</text></inputExpression>
      </input>
      <output id="saida-complexidade" label="complexidade" name="complexidade" typeRef="string" />
      <output id="saida-alcada" label="alcada" name="alcada" typeRef="string" />
      <rule id="regra-1">
        <inputEntry id="i-0-categoria"><text>"sensivel"</text></inputEntry>
        <inputEntry id="i-0-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-0-decisaoAutomatizada"><text>true</text></inputEntry>
        <inputEntry id="i-0-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-0-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-0-alcada"><text>"dpo_e_comite"</text></outputEntry>
      </rule>
      <rule id="regra-2">
        <inputEntry id="i-1-categoria"><text>-</text></inputEntry>
        <inputEntry id="i-1-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-1-decisaoAutomatizada"><text>true</text></inputEntry>
        <inputEntry id="i-1-transferenciaInternacional"><text>true</text></inputEntry>
        <outputEntry id="o-1-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-1-alcada"><text>"dpo_e_comite"</text></outputEntry>
      </rule>
      <rule id="regra-3">
        <inputEntry id="i-2-categoria"><text>"sensivel"</text></inputEntry>
        <inputEntry id="i-2-volumeTitulares"><text>&gt;= 100000</text></inputEntry>
        <inputEntry id="i-2-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-2-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-2-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-2-alcada"><text>"dpo_e_comite"</text></outputEntry>
      </rule>
      <rule id="regra-4">
        <inputEntry id="i-3-categoria"><text>"sensivel"</text></inputEntry>
        <inputEntry id="i-3-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-3-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-3-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-3-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-3-alcada"><text>"dpo"</text></outputEntry>
      </rule>
      <rule id="regra-5">
        <inputEntry id="i-4-categoria"><text>-</text></inputEntry>
        <inputEntry id="i-4-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-4-decisaoAutomatizada"><text>true</text></inputEntry>
        <inputEntry id="i-4-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-4-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-4-alcada"><text>"dpo"</text></outputEntry>
      </rule>
      <rule id="regra-6">
        <inputEntry id="i-5-categoria"><text>-</text></inputEntry>
        <inputEntry id="i-5-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-5-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-5-transferenciaInternacional"><text>true</text></inputEntry>
        <outputEntry id="o-5-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-5-alcada"><text>"dpo"</text></outputEntry>
      </rule>
      <rule id="regra-7">
        <inputEntry id="i-6-categoria"><text>-</text></inputEntry>
        <inputEntry id="i-6-volumeTitulares"><text>&gt;= 1000000</text></inputEntry>
        <inputEntry id="i-6-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-6-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-6-complexidade"><text>"media"</text></outputEntry>
        <outputEntry id="o-6-alcada"><text>"dpo"</text></outputEntry>
      </rule>
      <rule id="regra-8">
        <inputEntry id="i-7-categoria"><text>"pessoal"</text></inputEntry>
        <inputEntry id="i-7-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-7-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-7-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-7-complexidade"><text>"media"</text></outputEntry>
        <outputEntry id="o-7-alcada"><text>"dpo"</text></outputEntry>
      </rule>
      <rule id="regra-9">
        <inputEntry id="i-8-categoria"><text>"anonimizado","pseudonimizado"</text></inputEntry>
        <inputEntry id="i-8-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-8-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-8-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-8-complexidade"><text>"baixa"</text></outputEntry>
        <outputEntry id="o-8-alcada"><text>"tecnica"</text></outputEntry>
      </rule>
      <rule id="regra-10">
        <inputEntry id="i-9-categoria"><text>-</text></inputEntry>
        <inputEntry id="i-9-volumeTitulares"><text>-</text></inputEntry>
        <inputEntry id="i-9-decisaoAutomatizada"><text>-</text></inputEntry>
        <inputEntry id="i-9-transferenciaInternacional"><text>-</text></inputEntry>
        <outputEntry id="o-9-complexidade"><text>"alta"</text></outputEntry>
        <outputEntry id="o-9-alcada"><text>"dpo_e_comite"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
