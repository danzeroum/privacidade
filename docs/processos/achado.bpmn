<?xml version="1.0" encoding="UTF-8"?>
<!--
  PR-05 · Achado de auditoria — ciclo de vida do artefato "achado".

  Especificação de referência. O runtime que a executa é app/src/mock/estados.ts,
  e o teste de conformidade (app/tests/regras.test.tsx) reprova o build quando
  os dois divergem — em qualquer direção.

  Cada <task> é um estado; cada <sequenceFlow> entre tasks é uma transição legal.
  O que este arquivo NÃO diz, de propósito: o conteúdo que cada transição exige
  (fundamento, dono, prazo). Isso é validação e vive em app/src/mock/api.ts —
  misturar as duas produz 422 onde devia ser 409.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="definicoes-achado"
    targetNamespace="https://lastro.exemplo/processos">
  <bpmn:process id="achado" name="PR-05 · Achado de auditoria" isExecutable="false">
    <bpmn:documentation>Reaberto entra com criticidade elevada e conta como reincidência; retoma pela causa raiz, porque reincidência não recomeça do plano antigo.</bpmn:documentation>
    <bpmn:startEvent id="inicio" name="Achado de auditoria aberto">
      <bpmn:outgoing>flow-inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="aberto" name="aberto">
      <bpmn:incoming>flow-inicio</bpmn:incoming>
      <bpmn:outgoing>flow-aberto-causa_raiz</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="causa_raiz" name="causa raiz">
      <bpmn:incoming>flow-aberto-causa_raiz</bpmn:incoming>
      <bpmn:incoming>flow-reaberto-causa_raiz</bpmn:incoming>
      <bpmn:outgoing>flow-causa_raiz-plano</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="plano" name="plano">
      <bpmn:incoming>flow-causa_raiz-plano</bpmn:incoming>
      <bpmn:outgoing>flow-plano-executado</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="executado" name="executado">
      <bpmn:incoming>flow-plano-executado</bpmn:incoming>
      <bpmn:outgoing>flow-executado-verificado</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="verificado" name="verificado">
      <bpmn:incoming>flow-executado-verificado</bpmn:incoming>
      <bpmn:outgoing>flow-verificado-encerrado</bpmn:outgoing>
      <bpmn:outgoing>flow-verificado-reaberto</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reaberto" name="reaberto">
      <bpmn:incoming>flow-verificado-reaberto</bpmn:incoming>
      <bpmn:outgoing>flow-reaberto-causa_raiz</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="encerrado" name="encerrado">
      <bpmn:incoming>flow-verificado-encerrado</bpmn:incoming>
      <bpmn:outgoing>flow-encerrado-fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim-encerrado" name="encerrado">
      <bpmn:incoming>flow-encerrado-fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-inicio" sourceRef="inicio" targetRef="aberto" />
    <bpmn:sequenceFlow id="flow-aberto-causa_raiz" sourceRef="aberto" targetRef="causa_raiz" name="apurar causa raiz" />
    <bpmn:sequenceFlow id="flow-causa_raiz-plano" sourceRef="causa_raiz" targetRef="plano" name="propor plano" />
    <bpmn:sequenceFlow id="flow-plano-executado" sourceRef="plano" targetRef="executado" name="executar e anexar evidência" />
    <bpmn:sequenceFlow id="flow-executado-verificado" sourceRef="executado" targetRef="verificado" name="verificar eficácia" />
    <bpmn:sequenceFlow id="flow-verificado-encerrado" sourceRef="verificado" targetRef="encerrado" name="encerrar" />
    <bpmn:sequenceFlow id="flow-verificado-reaberto" sourceRef="verificado" targetRef="reaberto" name="reabrir com criticidade elevada" />
    <bpmn:sequenceFlow id="flow-reaberto-causa_raiz" sourceRef="reaberto" targetRef="causa_raiz" name="reapurar causa raiz" />
    <bpmn:sequenceFlow id="flow-encerrado-fim" sourceRef="encerrado" targetRef="fim-encerrado" />
  </bpmn:process>
</bpmn:definitions>
