<?xml version="1.0" encoding="UTF-8"?>
<!--
  PR-04 · Legítimo interesse (LIA) — ciclo de vida do artefato "lia".

  Especificação de referência. O runtime que a executa é app/src/mock/estados.ts,
  e o teste de conformidade (app/tests/regras.test.tsx) reprova o build quando
  os dois divergem — em qualquer direção.

  Cada <task> é um estado; cada <sequenceFlow> entre tasks é uma transição legal.
  O que este arquivo NÃO diz, de propósito: o conteúdo que cada transição exige
  (fundamento, dono, prazo). Isso é validação e vive em app/src/mock/api.ts —
  misturar as duas produz 422 onde devia ser 409.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="definicoes-lia"
    targetNamespace="https://lastro.exemplo/processos">
  <bpmn:process id="lia" name="PR-04 · Legítimo interesse (LIA)" isExecutable="false">
    <bpmn:documentation>Vencida nunca volta direto a vigente: renovar exige rebalanceamento, não recarimbo. em_revisao é vigência puxada de volta quando a mitigação cai (PR 7, Risco-007) — não é sinônimo de balanceamento, que é autoria; e também não volta direto a vigente.</bpmn:documentation>
    <bpmn:startEvent id="inicio" name="Legítimo interesse (LIA) aberto">
      <bpmn:outgoing>flow-inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="rascunho" name="rascunho">
      <bpmn:incoming>flow-inicio</bpmn:incoming>
      <bpmn:outgoing>flow-rascunho-balanceamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="balanceamento" name="balanceamento">
      <bpmn:incoming>flow-rascunho-balanceamento</bpmn:incoming>
      <bpmn:incoming>flow-vencida-balanceamento</bpmn:incoming>
      <bpmn:incoming>flow-em_revisao-balanceamento</bpmn:incoming>
      <bpmn:outgoing>flow-balanceamento-assinada</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="assinada" name="assinada">
      <bpmn:incoming>flow-balanceamento-assinada</bpmn:incoming>
      <bpmn:outgoing>flow-assinada-vigente</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="vigente" name="vigente">
      <bpmn:incoming>flow-assinada-vigente</bpmn:incoming>
      <bpmn:outgoing>flow-vigente-em_revisao</bpmn:outgoing>
      <bpmn:outgoing>flow-vigente-vencida</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="em_revisao" name="em_revisao">
      <bpmn:incoming>flow-vigente-em_revisao</bpmn:incoming>
      <bpmn:outgoing>flow-em_revisao-balanceamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="vencida" name="vencida">
      <bpmn:incoming>flow-vigente-vencida</bpmn:incoming>
      <bpmn:outgoing>flow-vencida-balanceamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow-inicio" sourceRef="inicio" targetRef="rascunho" />
    <bpmn:sequenceFlow id="flow-rascunho-balanceamento" sourceRef="rascunho" targetRef="balanceamento" name="balancear" />
    <bpmn:sequenceFlow id="flow-balanceamento-assinada" sourceRef="balanceamento" targetRef="assinada" name="assinar" />
    <bpmn:sequenceFlow id="flow-assinada-vigente" sourceRef="assinada" targetRef="vigente" name="publicar" />
    <bpmn:sequenceFlow id="flow-vigente-em_revisao" sourceRef="vigente" targetRef="em_revisao" name="mitigação caiu (teste de disparidade abaixo do piso)" />
    <bpmn:sequenceFlow id="flow-em_revisao-balanceamento" sourceRef="em_revisao" targetRef="balanceamento" name="rebalancear" />
    <bpmn:sequenceFlow id="flow-vigente-vencida" sourceRef="vigente" targetRef="vencida" name="vencer" />
    <bpmn:sequenceFlow id="flow-vencida-balanceamento" sourceRef="vencida" targetRef="balanceamento" name="renovar com rebalanceamento" />
  </bpmn:process>
</bpmn:definitions>
