<?xml version="1.0" encoding="UTF-8"?>
<!--
  PR-05 · Direito do titular — ciclo de vida do artefato "solicitacao".

  Especificação de referência. O runtime que a executa é app/src/mock/estados.ts,
  e o teste de conformidade (app/tests/regras.test.tsx) reprova o build quando
  os dois divergem — em qualquer direção.

  Cada <task> é um estado; cada <sequenceFlow> entre tasks é uma transição legal.
  O que este arquivo NÃO diz, de propósito: o conteúdo que cada transição exige
  (fundamento, dono, prazo). Isso é validação e vive em app/src/mock/api.ts —
  misturar as duas produz 422 onde devia ser 409.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="definicoes-solicitacao"
    targetNamespace="https://lastro.exemplo/processos">
  <bpmn:process id="solicitacao" name="PR-05 · Direito do titular" isExecutable="false">
    <bpmn:documentation>Recusa exige fundamento legal (Art. 18, §4º). Concluída e recusada param o cronômetro do prazo legal.</bpmn:documentation>
    <bpmn:startEvent id="inicio" name="Direito do titular aberto">
      <bpmn:outgoing>flow-inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="recebida" name="recebida">
      <bpmn:incoming>flow-inicio</bpmn:incoming>
      <bpmn:outgoing>flow-recebida-em_analise</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="em_analise" name="em analise">
      <bpmn:incoming>flow-recebida-em_analise</bpmn:incoming>
      <bpmn:outgoing>flow-em_analise-concluida</bpmn:outgoing>
      <bpmn:outgoing>flow-em_analise-recusada_com_fundamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="concluida" name="concluida">
      <bpmn:incoming>flow-em_analise-concluida</bpmn:incoming>
      <bpmn:outgoing>flow-concluida-fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recusada_com_fundamento" name="recusada com fundamento">
      <bpmn:incoming>flow-em_analise-recusada_com_fundamento</bpmn:incoming>
      <bpmn:outgoing>flow-recusada_com_fundamento-fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim-concluida" name="concluida">
      <bpmn:incoming>flow-concluida-fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fim-recusada_com_fundamento" name="recusada com fundamento">
      <bpmn:incoming>flow-recusada_com_fundamento-fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-inicio" sourceRef="inicio" targetRef="recebida" />
    <bpmn:sequenceFlow id="flow-recebida-em_analise" sourceRef="recebida" targetRef="em_analise" name="iniciar análise" />
    <bpmn:sequenceFlow id="flow-em_analise-concluida" sourceRef="em_analise" targetRef="concluida" name="concluir" />
    <bpmn:sequenceFlow id="flow-em_analise-recusada_com_fundamento" sourceRef="em_analise" targetRef="recusada_com_fundamento" name="recusar com fundamento legal" />
    <bpmn:sequenceFlow id="flow-concluida-fim" sourceRef="concluida" targetRef="fim-concluida" />
    <bpmn:sequenceFlow id="flow-recusada_com_fundamento-fim" sourceRef="recusada_com_fundamento" targetRef="fim-recusada_com_fundamento" />
  </bpmn:process>
</bpmn:definitions>
