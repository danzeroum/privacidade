<?xml version="1.0" encoding="UTF-8"?>
<!--
  D2@1 — Qual o nível do risco, o tratamento esperado e quem aprova?

  Especificação de referência. O runtime que a executa é app/src/mock/decisoes.ts,
  e o teste de conformidade varre todas as combinações de entrada exigindo a
  mesma saída. Divergência é build vermelho.

  Vigência declarada: a partir de 2025-09-01.
  Primeira publicação: as quatro faixas de score da matriz probabilidade × impacto.

  O que este arquivo NÃO diz: entrada ausente cai no cenário mais restritivo.
  Isso é contrato de aplicar(), em volta da tabela, e não linha da tabela — a
  tabela recebe entradas já preenchidas.
-->
<definitions
    xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
    xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/"
    id="definicoes-d2-v1"
    name="D2 versao 1"
    namespace="https://lastro.exemplo/decisoes">
  <decision id="d2" name="Qual o nível do risco, o tratamento esperado e quem aprova?">
    <decisionTable id="tabela-d2-v1" hitPolicy="FIRST">
      <input id="entrada-probabilidade" label="probabilidade">
        <inputExpression id="expr-probabilidade" typeRef="number"><text>probabilidade</text></inputExpression>
      </input>
      <input id="entrada-impacto" label="impacto">
        <inputExpression id="expr-impacto" typeRef="number"><text>impacto</text></inputExpression>
      </input>
      <input id="entrada-score" label="score">
        <inputExpression id="expr-score" typeRef="number"><text>score</text></inputExpression>
      </input>
      <output id="saida-nivel" label="nivel" name="nivel" typeRef="string" />
      <output id="saida-tratamento" label="tratamento" name="tratamento" typeRef="string" />
      <output id="saida-aprovador" label="aprovador" name="aprovador" typeRef="string" />
      <rule id="regra-1">
        <inputEntry id="i-0-probabilidade"><text>-</text></inputEntry>
        <inputEntry id="i-0-impacto"><text>-</text></inputEntry>
        <inputEntry id="i-0-score"><text>&gt;= 15</text></inputEntry>
        <outputEntry id="o-0-nivel"><text>"critico"</text></outputEntry>
        <outputEntry id="o-0-tratamento"><text>"evitar ou mitigar antes do go-live"</text></outputEntry>
        <outputEntry id="o-0-aprovador"><text>"DPO e comitê"</text></outputEntry>
      </rule>
      <rule id="regra-2">
        <inputEntry id="i-1-probabilidade"><text>-</text></inputEntry>
        <inputEntry id="i-1-impacto"><text>-</text></inputEntry>
        <inputEntry id="i-1-score"><text>&gt;= 8</text></inputEntry>
        <outputEntry id="o-1-nivel"><text>"alto"</text></outputEntry>
        <outputEntry id="o-1-tratamento"><text>"mitigar com dono e prazo"</text></outputEntry>
        <outputEntry id="o-1-aprovador"><text>"DPO"</text></outputEntry>
      </rule>
      <rule id="regra-3">
        <inputEntry id="i-2-probabilidade"><text>-</text></inputEntry>
        <inputEntry id="i-2-impacto"><text>-</text></inputEntry>
        <inputEntry id="i-2-score"><text>&gt;= 4</text></inputEntry>
        <outputEntry id="o-2-nivel"><text>"moderado"</text></outputEntry>
        <outputEntry id="o-2-tratamento"><text>"mitigar ou aceitar com prazo de reavaliação"</text></outputEntry>
        <outputEntry id="o-2-aprovador"><text>"DPO"</text></outputEntry>
      </rule>
      <rule id="regra-4">
        <inputEntry id="i-3-probabilidade"><text>-</text></inputEntry>
        <inputEntry id="i-3-impacto"><text>-</text></inputEntry>
        <inputEntry id="i-3-score"><text>&lt;= 3</text></inputEntry>
        <outputEntry id="o-3-nivel"><text>"baixo"</text></outputEntry>
        <outputEntry id="o-3-tratamento"><text>"aceitar com reavaliação anual"</text></outputEntry>
        <outputEntry id="o-3-aprovador"><text>"dono do domínio"</text></outputEntry>
      </rule>
      <rule id="regra-5">
        <inputEntry id="i-4-probabilidade"><text>-</text></inputEntry>
        <inputEntry id="i-4-impacto"><text>-</text></inputEntry>
        <inputEntry id="i-4-score"><text>-</text></inputEntry>
        <outputEntry id="o-4-nivel"><text>"critico"</text></outputEntry>
        <outputEntry id="o-4-tratamento"><text>"evitar ou mitigar antes do go-live"</text></outputEntry>
        <outputEntry id="o-4-aprovador"><text>"DPO e comitê"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
