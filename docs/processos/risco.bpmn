<?xml version="1.0" encoding="UTF-8"?>
<!--
  PR-04 · Ciclo de risco — ciclo de vida do artefato "risco".

  Especificação de referência. O runtime que a executa é app/src/mock/estados.ts,
  e o teste de conformidade (app/tests/regras.test.tsx) reprova o build quando
  os dois divergem — em qualquer direção.

  Cada <task> é um estado; cada <sequenceFlow> entre tasks é uma transição legal.
  O que este arquivo NÃO diz, de propósito: o conteúdo que cada transição exige
  (fundamento, dono, prazo). Isso é validação e vive em app/src/mock/api.ts —
  misturar as duas produz 422 onde devia ser 409.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="definicoes-risco"
    targetNamespace="https://lastro.exemplo/processos">
  <bpmn:process id="risco" name="PR-04 · Ciclo de risco" isExecutable="false">
    <bpmn:documentation>Aceito exige dono, prazo de reavaliação e gatilho de reabertura. Aceito e mitigado voltam a tratamento: risco reavaliado é risco vivo.</bpmn:documentation>
    <bpmn:startEvent id="inicio" name="Ciclo de risco aberto">
      <bpmn:outgoing>flow-inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="identificado" name="identificado">
      <bpmn:incoming>flow-inicio</bpmn:incoming>
      <bpmn:outgoing>flow-identificado-avaliado</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="avaliado" name="avaliado">
      <bpmn:incoming>flow-identificado-avaliado</bpmn:incoming>
      <bpmn:outgoing>flow-avaliado-em_tratamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="em_tratamento" name="em tratamento">
      <bpmn:incoming>flow-avaliado-em_tratamento</bpmn:incoming>
      <bpmn:incoming>flow-mitigado-em_tratamento</bpmn:incoming>
      <bpmn:incoming>flow-aceito-em_tratamento</bpmn:incoming>
      <bpmn:outgoing>flow-em_tratamento-mitigado</bpmn:outgoing>
      <bpmn:outgoing>flow-em_tratamento-aceito</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="mitigado" name="mitigado">
      <bpmn:incoming>flow-em_tratamento-mitigado</bpmn:incoming>
      <bpmn:outgoing>flow-mitigado-em_tratamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="aceito" name="aceito">
      <bpmn:incoming>flow-em_tratamento-aceito</bpmn:incoming>
      <bpmn:outgoing>flow-aceito-em_tratamento</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow-inicio" sourceRef="inicio" targetRef="identificado" />
    <bpmn:sequenceFlow id="flow-identificado-avaliado" sourceRef="identificado" targetRef="avaliado" name="avaliar P × I" />
    <bpmn:sequenceFlow id="flow-avaliado-em_tratamento" sourceRef="avaliado" targetRef="em_tratamento" name="definir tratamento e dono" />
    <bpmn:sequenceFlow id="flow-em_tratamento-mitigado" sourceRef="em_tratamento" targetRef="mitigado" name="mitigar" />
    <bpmn:sequenceFlow id="flow-em_tratamento-aceito" sourceRef="em_tratamento" targetRef="aceito" name="aceitar com dono e prazo" />
    <bpmn:sequenceFlow id="flow-mitigado-em_tratamento" sourceRef="mitigado" targetRef="em_tratamento" name="reabrir por gatilho" />
    <bpmn:sequenceFlow id="flow-aceito-em_tratamento" sourceRef="aceito" targetRef="em_tratamento" name="reavaliar no prazo" />
  </bpmn:process>
</bpmn:definitions>
