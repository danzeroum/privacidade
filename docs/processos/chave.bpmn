<?xml version="1.0" encoding="UTF-8"?>
<!--
  PR-03 · Ciclo de chave criptográfica — ciclo de vida do artefato "chave".

  Especificação de referência. O runtime que a executa é app/src/mock/estados.ts,
  e o teste de conformidade (app/tests/regras.test.tsx) reprova o build quando
  os dois divergem — em qualquer direção.

  Cada <task> é um estado; cada <sequenceFlow> entre tasks é uma transição legal.
  O que este arquivo NÃO diz, de propósito: o conteúdo que cada transição exige
  (fundamento, dono, prazo). Isso é validação e vive em app/src/mock/api.ts —
  misturar as duas produz 422 onde devia ser 409.
-->
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    id="definicoes-chave"
    targetNamespace="https://lastro.exemplo/processos">
  <bpmn:process id="chave" name="PR-03 · Ciclo de chave criptográfica" isExecutable="false">
    <bpmn:documentation>Promover antes do canary deixa registro ilegível com a chave nova. Chave vencida não quebra o sistema: para de proteger em silêncio.</bpmn:documentation>
    <bpmn:startEvent id="inicio" name="Ciclo de chave criptográfica aberto">
      <bpmn:outgoing>flow-inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="nova" name="nova">
      <bpmn:incoming>flow-inicio</bpmn:incoming>
      <bpmn:outgoing>flow-nova-recriptografando</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recriptografando" name="recriptografando">
      <bpmn:incoming>flow-nova-recriptografando</bpmn:incoming>
      <bpmn:outgoing>flow-recriptografando-canary</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="canary" name="canary">
      <bpmn:incoming>flow-recriptografando-canary</bpmn:incoming>
      <bpmn:outgoing>flow-canary-ativa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ativa" name="ativa">
      <bpmn:incoming>flow-canary-ativa</bpmn:incoming>
      <bpmn:outgoing>flow-ativa-revogada</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="revogada" name="revogada">
      <bpmn:incoming>flow-ativa-revogada</bpmn:incoming>
      <bpmn:outgoing>flow-revogada-fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim-revogada" name="revogada">
      <bpmn:incoming>flow-revogada-fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-inicio" sourceRef="inicio" targetRef="nova" />
    <bpmn:sequenceFlow id="flow-nova-recriptografando" sourceRef="nova" targetRef="recriptografando" name="recriptografar" />
    <bpmn:sequenceFlow id="flow-recriptografando-canary" sourceRef="recriptografando" targetRef="canary" name="abrir janela de canary" />
    <bpmn:sequenceFlow id="flow-canary-ativa" sourceRef="canary" targetRef="ativa" name="promover" />
    <bpmn:sequenceFlow id="flow-ativa-revogada" sourceRef="ativa" targetRef="revogada" name="revogar" />
    <bpmn:sequenceFlow id="flow-revogada-fim" sourceRef="revogada" targetRef="fim-revogada" />
  </bpmn:process>
</bpmn:definitions>
